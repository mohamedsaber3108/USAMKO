# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://usamko:dev_password@localhost:5432/usamko_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (REQUIRED for credential vault)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=your_64_character_hex_key_here_generate_with_command_above

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# AWS Bedrock (You're using this for AI!)
# Get credentials from AWS Console: https://console.aws.amazon.com/iam/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ===================================================================
# FREE RESEARCH APIs (ALL OPTIONAL - System works without them!)
# ===================================================================

# Hunter.io - Email Finder (FREE: 25 searches/month)
# Sign up: https://hunter.io/users/sign_up
HUNTER_API_KEY=your-hunter-io-api-key-optional

# Clearbit - Company Data (FREE tier available)
# Sign up: https://clearbit.com/free-trial
CLEARBIT_API_KEY=your-clearbit-api-key-optional

# Kaggle - Millions of FREE datasets
# Get API key: https://www.kaggle.com/settings/account
KAGGLE_USERNAME=your-kaggle-username-optional
KAGGLE_KEY=your-kaggle-api-key-optional

# Google Custom Search - 100 FREE searches/day
# Get API key: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=your-google-search-key-optional
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id-optional

# ===================================================================
# AI APIs (Bedrock is primary - these are fallback)
# ===================================================================
OPENAI_API_KEY=your-openai-api-key  # Fallback only
ANTHROPIC_API_KEY=your-anthropic-api-key  # Optional

# OAuth Providers (for social platform connections)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret